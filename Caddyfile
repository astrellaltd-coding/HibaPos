# HibaPOS France — Caddy reverse proxy.
#
# Security note: the `?XTransformPort=<port>` query handler is an internal
# platform feature used by the deploy orchestrator to health-check other
# processes. Previously this was an OPEN PROXY — any caller on the network
# could reach any localhost port via `?XTransformPort=<arbitrary>`.
#
# Allowlist: the handler only fires when the requested port matches the
# anchored pattern ^8[0-9]{3}$ (the platform mini-services range 8000-8999).
# NOTE: Caddy's `query` matcher does NOT support regex — it only does
# exact/wildcard matching — so we use `vars_regexp` against the
# {query.XTransformPort} placeholder with an anchored pattern.
#
# When exposing Caddy to the Internet, ALWAYS front it with TLS. The default
# :81 listener uses plain HTTP — only safe on a loopback interface or behind
# an SSL-terminating load balancer.

:81 {
	@transform_port vars_regexp port {query.XTransformPort} ^8[0-9]{3}$

	handle @transform_port {
		reverse_proxy localhost:{query.XTransformPort} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Default: proxy everything else to the HibaPOS Next.js server.
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
