# HibaPOS France — Required Environment Variables

# SQLite database path. URL params apply Pragma on each Prisma connection:
#   - `_fk=1`           enables foreign key enforcement
#   - `_busy_timeout=5000` makes SQLite wait up to 5s on lock contention
#                         rather than immediately throwing SQLITE_BUSY
# `PRAGMA journal_mode = WAL` is a persistent file-level setting; set it once
# on the DB file via the sqlite3 CLI: `sqlite3 db/custom.db "PRAGMA journal_mode=WAL;"`
DATABASE_URL="file:./db/custom.db?_fk=1&_busy_timeout=5000"

# Session cookie signing secret (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=""

# Backup encryption key (min 32 chars; used for AES-256-GCM with per-file salted scrypt derivation)
BACKUP_ENCRYPTION_KEY=""

# Next.js public URL (used for metadata / sitemap if applicable)
APP_URL="http://localhost:3000"

# Where HibaPOS keeps its data: database, backups, fiscal archives, uploads.
#
# DD-02 (2026-09-03): production uses C:\HibaPOS\data — writable without
# elevation, outside OneDrive (which locks SQLite files), and outside the
# install directory so an update cannot touch it.
#
# Unset keeps the historical layout (everything under the install directory),
# so an existing install is not silently pointed at an empty folder by a code
# update. Moving is an explicit deployment step: set this, move the files,
# and point DATABASE_URL at the new db/custom.db.
# HIBAPOS_DATA_DIR="C:/HibaPOS/data"

# Backup storage location (defaults to <data dir>/db/backups).
#
# SET THIS. Left unset, backups sit next to custom.db on the same disk, so one
# disk failure, one ransomware event or one deleted folder takes the database
# and every copy of it together. Point it at a second physical volume — an
# external drive, a NAS share, anything that is not this disk.
#   Windows example: BACKUP_LOCATION="D:/HibaPOS-Sauvegardes"
# BACKUP_LOCATION=""

# How many backups to keep (defaults to 30, about a month of daily Z closes).
# One backup is created per Z close; older ones beyond this limit are deleted
# with their media archives and the deletion is journalled. Values below 1 are
# ignored — a retention of 0 would delete the backup it had just made.
# BACKUP_RETENTION_COUNT="30"

# How long technical logs are kept, in days (default 90). These are
# operational noise — backup results, printer failures, stack traces — and
# they are written into the same SQLite file as the fiscal data, so an
# unbounded log table competes for the same write lock as a checkout.
# 0 disables pruning.
# TECHNICAL_LOG_RETENTION_DAYS="90"

# How long audit logs are kept, in days. DEFAULT 0 = keep forever.
# Audit rows record who approved a discount, who refunded, who restored a
# backup. How long that evidence must live is a business and legal question,
# so nothing is deleted unless you set this deliberately.
# The fiscal journal (FiscalEvent) is NEVER pruned, by either setting.
# AUDIT_LOG_RETENTION_DAYS="0"

# Optional: override the bootstrap admin/manager PINs (only used by `prisma db seed`).
# Defaults are 123456 / 111111 — rotate immediately after first login.
# SEED_ADMIN_PIN="123456"
# SEED_MANAGER_PIN="111111"
