# HibaPOS France — Required Environment Variables

# SQLite database path. URL params apply Pragma on each Prisma connection:
#   - `_fk=1`           enables foreign key enforcement
#   - `_busy_timeout=5000` makes SQLite wait up to 5s on lock contention
#                         rather than immediately throwing SQLITE_BUSY
# `PRAGMA journal_mode = WAL` is a persistent file-level setting; set it once
# on the DB file via the sqlite3 CLI: `sqlite3 db/custom.db "PRAGMA journal_mode=WAL;"`
DATABASE_URL="file:./db/custom.db?_fk=1&_busy_timeout=5000"

# Session cookie signing secret (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=""

# Backup encryption key (min 32 chars; used for AES-256-GCM with per-file salted scrypt derivation)
BACKUP_ENCRYPTION_KEY=""

# Next.js public URL (used for metadata / sitemap if applicable)
APP_URL="http://localhost:3000"

# Optional: backup storage location override (defaults to ./db/backups)
# BACKUP_LOCATION=""

# Optional: override the bootstrap admin/manager PINs (only used by `prisma db seed`).
# Defaults are 123456 / 111111 — rotate immediately after first login.
# SEED_ADMIN_PIN="123456"
# SEED_MANAGER_PIN="111111"
